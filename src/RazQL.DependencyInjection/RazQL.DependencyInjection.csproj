<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RazQL.DependencyInjection</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>RazQL.DependencyInjection</Title>
    <Description>Microsoft dependency injection registration for RazQL runtime services and generated mappers.</Description>
    <PackageTags>RazQL;dependency-injection;DI;mapper</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="RazorEngineCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RazQL/RazQL.csproj" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
