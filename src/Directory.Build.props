<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>Yellow Moon Software</Authors>
    <Company>Yellow Moon Software</Company>
    <Copyright>Copyright (c) 2026 Peter Meyer</Copyright>
    <PackageProjectUrl>https://github.com/yellowmoonsoftware/RazQL</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yellowmoonsoftware/RazQL</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>razql-icon.png</PackageIcon>
    <PackageReleaseNotes>Early-development 0.x release with Razor SQL templates, parameter binding, generated mappers, and optional Dapper association mapping. See https://github.com/yellowmoonsoftware/RazQL/releases for changes and compatibility notes.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../assets/razql-icon.png" Pack="true" PackagePath="razql-icon.png"/>
  </ItemGroup>
</Project>
