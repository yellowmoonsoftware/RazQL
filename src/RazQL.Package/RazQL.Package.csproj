<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>RazQL</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <Title>RazQL</Title>
    <Description>RazQL runtime, source generator, and Dapper adapter for Razor-based SQL mappers.</Description>
    <PackageTags>RazQL;Razor;SQL;mapper;source-generator;Dapper</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- This project intentionally produces a dependency-only package without lib/ref assets. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RazQL/RazQL.csproj" PrivateAssets="none" />
    <ProjectReference Include="../RazQL.Generators/RazQL.Generators.csproj" PrivateAssets="none" />
    <ProjectReference Include="../RazQL.Dapper/RazQL.Dapper.csproj" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
