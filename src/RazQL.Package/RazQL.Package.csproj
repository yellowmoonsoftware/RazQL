<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>RazQL</PackageId>
    <Description>Razor-based SQL mapper runtime and source generator for .NET.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- This project intentionally produces a dependency-only package without lib/ref assets. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RazQL/RazQL.csproj" PrivateAssets="none" />
    <ProjectReference Include="../RazQL.Generators/RazQL.Generators.csproj" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
