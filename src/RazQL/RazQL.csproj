<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>RazQL.Core</PackageId>
    <RootNamespace>RazQL</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>RazQL.Core</Title>
    <Description>Provider-neutral Razor SQL template runtime, binding, loading, and execution contracts for RazQL.</Description>
    <PackageTags>RazQL;Razor;SQL;templating;mapping</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="RazorEngineCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RazQL.Tests" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
