<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RazQL.Dapper</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>RazQL.Dapper</Title>
    <Description>Dapper execution adapter for RazQL parameterized SQL queries.</Description>
    <PackageTags>RazQL;Dapper;SQL;data-access</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RazQL/RazQL.csproj" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
